    {
      "parameters": {
        "jsCode": "// Baut aus der Anfrage des Dashboards die Änderung(en) für die Firefly-API\nconst b = $('Webhook').first().json.body || {};\nconst put = (groupId, split, hooks = true) => ({ json: {\n  id: String(groupId),\n  payload: { apply_rules: false, fire_webhooks: hooks, transactions: [split] },\n} });\nif (b.typ === 'kategorie_setzen') {\n  // category_name legt eine noch unbekannte Kategorie automatisch an\n  return [put(b.transaction_group_id, { transaction_journal_id: String(b.transaction_journal_id), category_name: String(b.kategorie || '') })];\n}\nif (b.typ === 'tags_setzen') {\n  return [put(b.transaction_group_id, { transaction_journal_id: String(b.transaction_journal_id), tags: (b.tags || []).map(String) })];\n}\nif (b.typ === 'kategorien_uebernehmen') {\n  // Sammeländerung aus dem Kategorien-Labor\n  return (b.aenderungen || []).map((a) => put(a.transaction_group_id, {\n    transaction_journal_id: String(a.transaction_journal_id),\n    ...(a.kategorie ? { category_name: String(a.kategorie) } : {}),\n    ...(Array.isArray(a.tags) ? { tags: a.tags.map(String) } : {}),\n  }));\n}\nif (b.typ === 'gegenkonto_setzen') {\n  // CSV-Abgleich: Empfänger (Ausgabe) bzw. Zahler (Einnahme) nachtragen, optional Beschreibung/Tags.\n  // Firefly ordnet das Gegenkonto über Name/IBAN zu und legt es an, falls es fehlt.\n  return (b.aenderungen || []).map((a) => {\n    const side = a.art === 'deposit' ? 'source' : 'destination';\n    const split = { transaction_journal_id: String(a.transaction_journal_id) };\n    if (a.gegenkonto !== false) {\n      split[side + '_id'] = null;\n      split[side + '_name'] = String(a.name || '');\n      if (a.iban) split[side + '_iban'] = String(a.iban);\n      if (a.bic) split[side + '_bic'] = String(a.bic);\n    }\n    if (a.beschreibung) split.description = String(a.beschreibung);\n    if (Array.isArray(a.tags)) split.tags = a.tags.map(String); // komplette neue Liste\n    return put(a.transaction_group_id, split, false); // keine Firefly-Webhooks je Buchung\n  });\n}\nthrow new Error('Unbekannter typ: ' + b.typ);"
      },
