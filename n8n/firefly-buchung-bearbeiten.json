    {
      "parameters": {
        "jsCode": "// Regelgruppe suchen: über die Markierung (gruppe_key, z. B. „gid:…“) in der\n// Beschreibung – so auch nach dem Umbenennen –, sonst über den Titel\nconst body = $('Webhook').first().json.body;\nconst groups = $input.first().json.data || [];\nconst found = (body.gruppe_key && groups.find((g) => (g.attributes.description || '').includes(body.gruppe_key)))\n  || groups.find((g) => g.attributes.title === body.gruppe);\nreturn [{ json: { id: found ? found.id : '', rename: Boolean(found && found.attributes.title !== body.gruppe) } }];"
