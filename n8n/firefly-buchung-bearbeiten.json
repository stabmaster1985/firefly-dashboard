    {
      "parameters": {
        "jsCode": "// Regelgruppe des Labors suchen (Titel kommt vom Dashboard)\nconst title = $('Webhook').first().json.body.gruppe;\nconst found = ($input.first().json.data || []).find((g) => g.attributes.title === title);\nreturn [{ json: { id: found ? found.id : '' } }];"
      },
