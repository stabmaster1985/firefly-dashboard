    {
      "parameters": {
        "jsCode": "// Baut aus der Anfrage des Dashboards die Änderung(en) für die Firefly-API\nconst b = $('Webhook').first().json.body || {};\nconst put = (groupId, split) => ({ json: {\n  id: String(groupId),\n  payload: { apply_rules: false, fire_webhooks: true, transactions: [split] },\n} });\nif (b.typ === 'kategorie_setzen') {\n  // category_name legt eine noch unbekannte Kategorie automatisch an\n  return [put(b.transaction_group_id, { transaction_journal_id: String(b.transaction_journal_id), category_name: String(b.kategorie || '') })];\n}\nif (b.typ === 'tags_setzen') {\n  return [put(b.transaction_group_id, { transaction_journal_id: String(b.transaction_journal_id), tags: (b.tags || []).map(String) })];\n}\nif (b.typ === 'kategorien_uebernehmen') {\n  // Sammeländerung aus dem Kategorien-Labor\n  return (b.aenderungen || []).map((a) => put(a.transaction_group_id, {\n    transaction_journal_id: String(a.transaction_journal_id),\n    ...(a.kategorie ? { category_name: String(a.kategorie) } : {}),\n    ...(Array.isArray(a.tags) ? { tags: a.tags.map(String) } : {}),\n  }));\n}\nthrow new Error('Unbekannter typ: ' + b.typ);"
      },
      "id": "c1",
      "name": "Änderung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        560
      ]
    },
