      "parameters": {
        "jsCode": "const counts = { angelegt: 0, aktualisiert: 0, entfernt: 0 };\nfor (const it of $('Abgleich').all()) if (counts[it.json.art] !== undefined) counts[it.json.art] += 1;\nconst anwenden = $('Webhook').first().json.body.anwenden || null;\nreturn [{ json: { ok: true, ...counts, gruppe_id: $('Gruppen-ID').first().json.id, anwenden } }];"
      },
