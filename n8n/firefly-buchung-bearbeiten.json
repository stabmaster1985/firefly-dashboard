      "id": "r6",
      "name": "Regeln der Gruppe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2020,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Labor-Regeln mit den Regeln der Gruppe abgleichen: anlegen, ändern, entfernen.\n// Zuordnung über die Markierung „id:<Labor-ID>“ in der Beschreibung.\nconst base = $('Einstellungen').first().json.firefly_url + '/api/v1';\nconst groupId = $('Gruppen-ID').first().json.id;\nconst wanted = $('Webhook').first().json.body.regeln || [];\nconst existing = $input.first().json.data || [];\nconst marker = (d) => (/id:(\\S+)/.exec(d || '') || [])[1];\nconst byLabId = new Map(existing.map((r) => [marker(r.attributes.description), r]));\nconst items = [];\nfor (const r of wanted) {\n  const body = {\n    title: r.title, description: r.description, rule_group_id: groupId, order: r.order,\n    trigger: r.trigger || 'store-journal', active: r.active !== false, strict: r.strict !== false,\n    stop_processing: Boolean(r.stop_processing), triggers: r.triggers, actions: r.actions,\n  };\n  const old = byLabId.get(r.labor_id);\n  items.push({ json: old\n    ? { method: 'PUT', url: base + '/rules/' + old.id, body, art: 'aktualisiert' }\n    : { method: 'POST', url: base + '/rules', body, art: 'angelegt' } });\n}\nconst keep = new Set(wanted.map((r) => r.labor_id));\nfor (const r of existing) {\n  const id = marker(r.attributes.description);\n  if (id && !keep.has(id)) items.push({ json: { method: 'DELETE', url: base + '/rules/' + r.id, body: null, art: 'entfernt' } });\n}\n// nie ohne Element enden, sonst antwortet der Webhook nicht\nif (!items.length) items.push({ json: { method: 'GET', url: base + '/rule-groups/' + groupId, body: null, art: 'nichts' } });\nreturn items;"
      },
