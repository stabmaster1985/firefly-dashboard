      "id": "k1",
      "name": "Konten?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        1060
      ],
      "notes": "„Daten aufräumen“ im Dashboard: Gegenkonten zusammenführen (Firefly-Sammelfunktion) und leere Konten löschen"
    },
    {
      "parameters": {
        "jsCode": "// Gegenkonten zusammenführen: Firefly verschiebt mit /data/bulk/transactions ALLE Buchungen\n// eines Kontos auf ein anderes (Kategorien, Tags, Beträge bleiben). Leere Konten löschen\n// kommt als eigener Aufruf – das Dashboard prüft vorher, dass sie wirklich leer sind.\nconst b = $('Webhook').first().json.body || {};\nconst base = $('Einstellungen').first().json.firefly_url + '/api/v1';\nconst items = [];\nif (b.typ === 'konten_zusammenfuehren') {\n  for (const p of b.paare || []) {\n    const query = JSON.stringify({ where: { account_id: Number(p.von) }, update: { account_id: Number(p.nach) } });\n    items.push({ json: { method: 'POST', url: base + '/data/bulk/transactions?query=' + encodeURIComponent(query), body: { query } } });\n  }\n  for (const r of b.umbenennen || []) items.push({ json: { method: 'PUT', url: base + '/accounts/' + r.id, body: { name: String(r.name) } } });\n}\nif (b.typ === 'konten_loeschen') {\n  for (const id of b.ids || []) items.push({ json: { method: 'DELETE', url: base + '/accounts/' + id, body: {} } });\n}\nif (!items.length) throw new Error('Nichts zu tun.');\nreturn items;"
      },
      "id": "k2",
      "name": "Konten-Anfragen bauen",
      "type": "n8n-nodes-base.code",
