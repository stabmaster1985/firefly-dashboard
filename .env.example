# Adresse deiner Firefly-III-Instanz (ohne /api)
FIREFLY_URL=https://firefly.example.com

# Personal Access Token: Firefly → Optionen → Profil → OAuth → "Persönliche Zugangs-Tokens"
FIREFLY_TOKEN=

# Optional: Port des Dashboards (Standard 8080)
# PORT=8080

# Optional, aber empfohlen: Passwortschutz (HTTP Basic Auth)
# DASHBOARD_USER=ich
# DASHBOARD_PASSWORD=

# Optional: Adresse für "In Firefly öffnen"-Links, falls sie sich von FIREFLY_URL
# unterscheidet (z. B. wenn FIREFLY_URL ein interner Docker-Name ist)
# FIREFLY_PUBLIC_URL=https://firefly.example.com

# Optional: Zwischenspeicher – laufender Zeitraum (Sekunden) / abgeschlossene Zeiträume (Stunden)
# CACHE_SECONDS=60
# CACHE_HISTORY_HOURS=12
# Optional: Daten alle N Minuten im Hintergrund vorladen (0 = aus)
# WARM_MINUTES=10
# Optional: höchstens so viele Anfragen gleichzeitig an Firefly
# FIREFLY_CONCURRENCY=4

# Optional: Auf neue Versionen prüfen (GitHub, höchstens einmal pro Stunde); 0 = aus
# UPDATE_CHECK=1
# UPDATE_REPO=stabmaster1985/firefly-dashboard
