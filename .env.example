# Adresse deiner Firefly-III-Instanz (ohne /api)
FIREFLY_URL=https://firefly.example.com

# Personal Access Token: Firefly → Optionen → Profil → OAuth → "Persönliche Zugangs-Tokens"
FIREFLY_TOKEN=

# Optional: Port des Dashboards (Standard 8080)
# PORT=8080

# Optional, aber empfohlen: Passwortschutz (HTTP Basic Auth)
# DASHBOARD_USER=ich
# DASHBOARD_PASSWORD=

# Optional: Adresse für "In Firefly öffnen"-Links, falls sie sich von FIREFLY_URL
# unterscheidet (z. B. wenn FIREFLY_URL ein interner Docker-Name ist)
# FIREFLY_PUBLIC_URL=https://firefly.example.com

# Optional: Zwischenspeicher – laufender Zeitraum (Sekunden) / abgeschlossene Zeiträume (Stunden)
# CACHE_SECONDS=60
# CACHE_HISTORY_HOURS=12
# Optional: Daten alle N Minuten im Hintergrund vorladen (0 = aus)
# WARM_MINUTES=10
# Optional: höchstens so viele Anfragen gleichzeitig an Firefly
# FIREFLY_CONCURRENCY=4

# Optional: Auf neue Versionen prüfen (GitHub, höchstens einmal pro Stunde); 0 = aus
# UPDATE_CHECK=1
# UPDATE_REPO=stabmaster1985/firefly-dashboard

# Optional: Ollama für die KI-Analyse im Labor (auch in der Oberfläche einstellbar)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional: Kennzahlen per MQTT an Home Assistant (Discovery, Gerät „Firefly Finanzen“) – siehe README
# MQTT_ENABLED=true
# MQTT_URL=mqtt://homeassistant.local:1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_BASE_TOPIC=firefly_dashboard
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_PUBLISH_INTERVAL=1800
# Konten einzeln als Sensor (Firefly-Konto-IDs, kommagetrennt)
# MQTT_ACCOUNTS=
# Gruppen einzeln abschalten
# MQTT_SEND_BALANCES=true
# MQTT_SEND_MONTH=true
# MQTT_SEND_BUDGETS=true
# MQTT_SEND_RECURRING=true
# Monat: kalender oder gehalt
# MQTT_MONTH=kalender
# Adresse des Dashboards für „Gerät besuchen“ in Home Assistant
# PUBLIC_URL=http://dashboard.local:8080
